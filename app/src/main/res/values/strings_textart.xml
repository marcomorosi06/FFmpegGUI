    <string name="textart_keyboard">The keys</string>
    <string name="textart_keyboard_count">%1$d of %2$d used</string>
    <string name="textart_keyboard_hint">The bar under each key is its ink, measured on the font. Tap a key to switch it, hold it to prefer or avoid it.</string>
    <string name="textart_key_active">Used</string>
    <string name="textart_key_off">Switched off</string>
