    <!-- Picture -->
    <string name="textart_crop_none">Whole picture</string>
    <string name="textart_picture_hint">The art is made of the picture as it is here: the frame, turned and cropped. Light and colour for the art are in its own tools.</string>

    <!-- Style -->
    <string name="textart_target_title">Where it is going</string>
    <string name="textart_target_hint">Each place sets the size, the page and the characters that suit it. Everything stays yours to change.</string>
    <string name="textart_target_terminal">Terminal</string>
    <string name="textart_target_editor">Text editor</string>
    <string name="textart_target_markdown">Markdown</string>
    <string name="textart_target_chat">Chat</string>
    <string name="textart_target_bbs">BBS</string>
    <string name="textart_mode_title">How it is drawn</string>
    <string name="textart_mode_ramp">Ramp</string>
    <string name="textart_mode_shape">Shapes</string>
    <string name="textart_mode_edges">Lines</string>
    <string name="textart_mode_blocks">Shades</string>
    <string name="textart_mode_half">Half blocks</string>
    <string name="textart_mode_quadrants">Quadrants</string>
    <string name="textart_mode_braille">Braille</string>
    <string name="textart_mode_text">Your words</string>
    <string name="textart_mode_ramp_hint">Each character stands for a cell, picked by how much ink it has: the classic ASCII art.</string>
    <string name="textart_mode_shape_hint">The character whose shape is closest to the cell, looked at in small parts: edges and curves come out.</string>
    <string name="textart_mode_edges_hint">Lines drawn along the edges of the picture, the rest from the ramp or left empty.</string>
    <string name="textart_mode_blocks_hint">Space and the four shade blocks: smooth tones, few characters.</string>
    <string name="textart_mode_half_hint">Two pixels a character, one above the other. In colour, the sharpest of all.</string>
    <string name="textart_mode_quadrants_hint">Four pixels a character, two by two. Not every font has these blocks.</string>
    <string name="textart_mode_braille_hint">Eight dots a character: the finest detail. Not in code page 437.</string>
    <string name="textart_mode_text_hint">The picture written with the letters of your phrase, over and over: dark letters on the ink, spaces on the paper.</string>
    <string name="textart_phrase">Your phrase</string>
    <string name="textart_columns">Columns</string>
    <string name="textart_rows">Lines</string>
    <string name="textart_rows_auto">%1$d, from the shape</string>
    <string name="textart_size_title">Size</string>
    <string name="textart_size_cells">%1$d characters</string>
    <string name="textart_size_presets">Common widths</string>
    <string name="textart_size_link">Keep the picture\'s shape</string>
    <string name="textart_size_unlink">Set the lines on their own</string>
    <string name="textart_size_hint_linked">The lines follow the picture\'s shape: drag either slider and the other comes along. 80 columns fit a classic terminal.</string>
    <string name="textart_size_hint_free">The lines are set on their own: the picture is stretched or squeezed to fill the grid.</string>
    <string name="textart_paper_title">Page</string>
    <string name="textart_paper_dark">Light on dark</string>
    <string name="textart_paper_light">Dark on light</string>
    <string name="textart_paper_hint">Terminals are dark, most editors are light: the ink follows the page the art is read on.</string>
    <string name="textart_aspect_auto">Cells as the font draws them</string>
    <string name="textart_aspect_auto_hint">A character is about half as wide as it is tall: the picture keeps its shape. Turn it off for a font of another shape.</string>
    <string name="textart_aspect">Cell width over height</string>

    <!-- Characters -->
