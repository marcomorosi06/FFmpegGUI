    <string name="textart_key_unencodable">Not in code page 437</string>
    <string name="textart_bias">How much %1$s is wanted</string>
    <string name="textart_bias_prefer">Preferred, %1$d</string>
    <string name="textart_bias_avoid">Avoided, %1$d</string>
    <string name="textart_bias_neutral">As any other</string>
    <string name="textart_bias_avoid_short">Avoid</string>
    <string name="textart_bias_prefer_short">Prefer</string>
    <string name="textart_extra">Characters of your own</string>
    <string name="textart_keys_reset">Every key back on</string>
    <string name="textart_filters">Safe for where it is going</string>
    <string name="textart_filter_ascii">ASCII only</string>
    <string name="textart_filter_ascii_hint">The 95 printable characters every place shows the same.</string>
    <string name="textart_filter_markdown">Safe in Markdown and chats</string>
    <string name="textart_filter_markdown_hint">Nothing read as formatting: no backquote, star, underscore, tilde, bar, hash or angle brackets.</string>
    <string name="textart_filter_comment">Safe in code comments</string>
    <string name="textart_filter_comment_hint">No star and no backslash: the art can neither close the comment nor run on to the next line.</string>
    <string name="textart_filter_lookalikes">No look-alikes</string>
    <string name="textart_filter_lookalikes_hint">None of l, 1, I, |, O and 0, which many fonts draw alike.</string>
    <string name="textart_filter_width">One column each</string>
    <string name="textart_filter_width_hint">Nothing that some East Asian terminals draw two columns wide, which would break the lines.</string>
    <string name="textart_limits">Limits</string>
    <string name="textart_dedupe">Merge alike characters</string>
    <string name="textart_dedupe_hint">Characters with nearly the same ink make no new step: one of them stays.</string>
    <string name="textart_max_share">Most cells for one character</string>
    <string name="textart_max_run">Longest run of one character</string>
    <string name="textart_limits_hint">A character that takes too much gives way to the next best: more texture, fewer flat patches.</string>
    <string name="textart_off">Off</string>

    <!-- Light -->
    <string name="textart_brightness">Brightness</string>
    <string name="textart_contrast">Contrast</string>
    <string name="textart_gamma">Gamma</string>
    <string name="textart_curve">Tone curve</string>
    <string name="textart_curve_hint">Drag the points up or down. A double tap makes it straight again.</string>
    <string name="textart_equalize">Use the whole ramp</string>
    <string name="textart_equalize_hint">Spreads the picture\'s light over every character, however dull the picture.</string>
    <string name="textart_invert">Negative</string>
    <string name="textart_invert_hint">Ink where the picture is light, paper where it is dark.</string>
    <string name="textart_edge_boost">Sharper edges</string>
    <string name="textart_edge_threshold">How strong an edge must be</string>
    <string name="textart_edge_fill">Fill between the lines</string>
    <string name="textart_edge_fill_hint">The cells off the edges are drawn from the ramp. Off, only the lines are left.</string>
    <string name="textart_dither">Dithering</string>
    <string name="textart_dither_none">None</string>
    <string name="textart_dither_bayer4">Bayer 4</string>
    <string name="textart_dither_bayer8">Bayer 8</string>
    <string name="textart_dither_fs">Floyd-Steinberg</string>
    <string name="textart_dither_atkinson">Atkinson</string>
    <string name="textart_dither_strength">Strength</string>
    <string name="textart_dither_glyphs">Characters</string>
    <string name="textart_dither_colors">Colours</string>
    <string name="textart_dither_both">Both</string>
    <string name="textart_dither_hint">Few steps make bands in smooth tones: dithering spreads the difference, as a pattern or as noise.</string>

    <!-- Colours -->
    <string name="textart_depth">Colours of the file</string>
    <string name="textart_depth_none">None</string>
    <string name="textart_depth_16">16</string>
    <string name="textart_depth_256">256</string>
    <string name="textart_depth_true">True colour</string>
    <string name="textart_depth_hint">16 colours show in every terminal, in its own theme. 256 in nearly all. True colour, exact, in today\'s terminals.</string>
    <string name="textart_depth_cp437_hint">A code page 437 file has the 16 colours of the ANSI art scene.</string>
    <string name="textart_theme">Terminal theme</string>
    <string name="textart_theme_hint">The 16 colours are painted by whoever opens the file: the art is matched to the theme chosen here, and shown so.</string>
    <string name="textart_theme_vga">VGA</string>
    <string name="textart_theme_xterm">xterm</string>
    <string name="textart_theme_windows">Windows</string>
    <string name="textart_theme_tango">Tango</string>
    <string name="textart_layer">What is coloured</string>
    <string name="textart_layer_fg">Characters</string>
    <string name="textart_layer_both">Characters and cells</string>
    <string name="textart_layer_hint">With the cells coloured too, each character has two colours: shapes and blocks come out much finer.</string>
    <string name="textart_match">Nearest colour by</string>
    <string name="textart_match_oklab">OKLab</string>
    <string name="textart_match_ciede">CIEDE2000</string>
    <string name="textart_match_rgb">RGB</string>
    <string name="textart_match_hint">OKLab and CIEDE2000 compare colours as the eye does; RGB as the screen does.</string>
    <string name="textart_saturation">Saturation</string>
    <string name="textart_reduce">Colours at most</string>
    <string name="textart_reduce_hint">The picture\'s colours are first brought down to this many: flatter, poster-like art.</string>
    <string name="textart_light_from_glyph">Light from the characters</string>
    <string name="textart_light_from_glyph_hint">Every colour as light as the others: the characters carry the light, the colours only the hue.</string>
    <string name="textart_bright">Bright colours as</string>
    <string name="textart_bright_bold">Bold</string>
    <string name="textart_bright_aixterm">Bright codes</string>
    <string name="textart_bright_hint">Old terminals and BBS viewers make bold bright; today\'s terminals know the bright codes.</string>
    <string name="textart_ice">iCE colours</string>
    <string name="textart_ice_hint">Bright backgrounds instead of blinking, as the SAUCE record says to viewers that read it.</string>
    <string name="textart_palette">The palette</string>
    <string name="textart_palette_hint">Tap a colour to never use it. Hold one, then tap another: the first is painted as the second.</string>
    <string name="textart_palette_reset">All back</string>
    <string name="textart_palette_banned">Never used</string>
    <string name="textart_palette_used">Used</string>
    <string name="textart_palette_remap_hint">Tap the colour to paint it as</string>
    <string name="textart_palette_unmap">Paint as itself</string>

    <!-- Leave out -->
    <string name="textart_hide_cutout">Cut out</string>
    <string name="textart_hide_cutout_hint">What the cut-out takes away stays empty in the art: the subject alone, or a colour keyed out.</string>
    <string name="textart_cutout_fill_hint">Text art has nothing behind: what is cut out is left empty.</string>
    <string name="textart_hide_colors">Colours</string>
    <string name="textart_hide_pick">Pick from the picture</string>
    <string name="textart_hide_pick_hint">Tap the stage: the colour under the finger is left out, with all those close to it.</string>
    <string name="textart_tolerance">How close</string>
    <string name="textart_swatch_hidden">Left out</string>
    <string name="textart_swatch_shown">Drawn</string>
    <string name="textart_hide_hues">Hues</string>
    <string name="textart_hide_hues_hint">Tap the ring to leave a hue out, drag the ends of its arc. Greys have no hue and stay.</string>
    <string name="textart_hue_ring">Colour wheel of the hues left out</string>
    <string name="textart_hue_min_chroma">Only colours more vivid than</string>
    <string name="textart_hue_remove">Draw this hue again</string>
    <string name="textart_hide_light">Lightness</string>
    <string name="textart_hide_light_range">Drawn from %1$d to %2$d</string>
    <string name="textart_hide_invert">Show only what is picked</string>
    <string name="textart_hide_invert_hint">The colours, hues and lightness above are what is drawn, and the rest is left out.</string>
    <string name="textart_brush">Brush</string>
    <string name="textart_brush_off">Zoom</string>
    <string name="textart_brush_hide">Leave out</string>
    <string name="textart_brush_show">Draw again</string>
    <string name="textart_brush_hint">Paint on the stage to leave cells out, or to bring them back.</string>
    <string name="textart_brush_size">Brush size</string>
    <string name="textart_brush_undo">Last stroke</string>
    <string name="textart_brush_clear">Every stroke</string>
    <string name="textart_alpha_cut">See-through below</string>
    <string name="textart_alpha_cut_hint">A pixel less opaque than this is not there, as the cut-out\'s soft edge fades.</string>

