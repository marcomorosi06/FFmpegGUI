    <string name="textart_frame">Frame</string>
    <string name="textart_frame_none">None</string>
    <string name="textart_frame_ascii">ASCII</string>
    <string name="textart_frame_single">Single</string>
    <string name="textart_frame_double">Double</string>
    <string name="textart_frame_rounded">Rounded</string>
    <string name="textart_frame_heavy">Heavy</string>
    <string name="textart_margin">Margin</string>
    <string name="textart_title">Title</string>
    <string name="textart_signature">Signature</string>
    <string name="textart_group">Group</string>
    <string name="textart_sauce_hint">Title, signature and group also go in the SAUCE record, read by the art scene\'s viewers. No date is written.</string>
    <string name="textart_encoding">File kind</string>
    <string name="textart_encoding_utf8">UTF-8</string>
    <string name="textart_encoding_cp437">Code page 437</string>
    <string name="textart_encoding_hint">UTF-8 for today\'s terminals. Code page 437 for the ANSI art scene, with its SAUCE record and 16 colours.</string>
    <string name="textart_line_ending">Line endings</string>
    <string name="textart_line_lf">LF</string>
    <string name="textart_line_crlf">CR LF</string>
    <string name="textart_trim">No spaces at line ends</string>
    <string name="textart_trim_hint">Smaller files, and nothing that editors mark as left over.</string>
    <string name="textart_bom">Byte order mark</string>
    <string name="textart_bom_hint">Helps old Windows programs know the file is UTF-8; most others do without it.</string>
    <string name="textart_reset_lines">Every line on its own</string>
    <string name="textart_reset_lines_hint">Each line ends with a reset: a line pasted alone keeps its colours. A little larger.</string>
    <string name="textart_max_width">Widest line allowed</string>
    <string name="textart_max_width_hint">The check warns when the art is wider: a chat or a page may wrap its lines.</string>

